# Copy these lines into backend/.env (that file must never be committed).
# Do NOT put real values in this example file: it is committed to git.
DATA_BACKEND=snowflake

SNOWFLAKE_ACCOUNT=<orgname-accountname>
SNOWFLAKE_USER=<your-snowflake-user>
SNOWFLAKE_ROLE=PUBLIC
SNOWFLAKE_WAREHOUSE=SNOWFLAKE_LEARNING_WH
SNOWFLAKE_DATABASE=SMART_ENERGY_DB
SNOWFLAKE_SCHEMA=SILVER
SNOWFLAKE_PASSWORD=<your-password>
