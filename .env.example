# ============================================================
# Smart Energy Intelligence Platform - shared settings
# Copy this file to .env  (cp .env.example .env). Never commit .env
# ============================================================

# --- Object storage (S3-compatible) ---------------------------------
# MinIO's official free images were withdrawn in Oct 2025, so we use
# Chainguard's free MinIO image. Swap the image here if the team prefers
# another build.
S3_IMAGE=cgr.dev/chainguard/minio:latest
S3_ROOT_USER=admin
# MinIO needs at least 8 characters
S3_ROOT_PASSWORD=change-me-please
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET=lakehouse

# Endpoints for code to use:
#   inside Docker (Spark container, generator container): http://minio:9000
#   on your laptop (scripts run directly on the host):    http://localhost:9000

# --- Kafka (single node, KRaft mode) --------------------------------
KAFKA_IMAGE=apache/kafka:3.9.0
KAFKA_HOST_PORT=9092
KAFKA_UI_PORT=8081

# Bootstrap servers for code to use:
#   inside Docker:  kafka:29092
#   on your laptop: localhost:9092

TOPIC_READINGS=ami-readings
TOPIC_STATUS=meter-status
TOPIC_ALERTS=anomaly-alerts
TOPIC_DLQ=ami-readings-dlq
READINGS_PARTITIONS=6

# --- Data generator --------------------------------------------------
GEN_SEED=42
GEN_NUM_METERS=1000
GEN_NUM_DAYS=7
GEN_START_DATE=2026-07-01
# From the EEHC report: ~42.1M subscribers / ~229.5k distribution transformers
GEN_METERS_PER_TRANSFORMER=183
